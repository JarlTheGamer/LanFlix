{
  "Lanflix": {
    "GitHubRepo": "JarlTheGamer/LanFlix",
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:3000",
        "http://localhost:5173",
        "http://localhost:8080",
        "http://localhost:4200",
        "http://192.168.178.13:5037"
      ]
    },
    "MediaPaths": {
      "Movies": "",
      "Series": "",
      "PosterCache": "",
      "BackdropCache": ""
    },
    "Transcoding": {
      "EnableHardwareAcceleration": false,
      "PreferredHwAccel": "auto",
      "MaxConcurrentTranscodes": 5,
      "TempPath": "",
      "DefaultBitrate": 0,
      "HlsSegmentDuration": 0
    },
    "Streaming": {
      "EnableDirectPlay": false,
      "EnableDirectStream": false,
      "ChunkSize": 0
    },
    "Cache": {
      "Redis": {
        "Enabled": false,
        "ConnectionString": "",
        "InstanceName": ""
      },
      "Memory": {
        "SizeLimit": 0
      }
    },
    "ExternalApis": {
      "Tmdb": {
        "ApiKey": "",
        "BaseUrl": "https://api.themoviedb.org/3/"
      },
      "Radarr": {
        "Url": "",
        "ApiKey": ""
      },
      "Sonarr": {
        "Url": "",
        "ApiKey": ""
      },
      "Prowlarr": {
        "Url": "",
        "ApiKey": ""
      }
    },
    "AppUpdates": {
      "ApkStoragePath": "D:/AppUpdates/Android",
      "EnableAutoUpdate": true
    },
    "ServerUpdates": {
      "EnableAutoUpdate": false,
      "CheckIntervalHours": 6,
      "UpdateCheckUrl": "https://api.github.com/repos/YOUR_USERNAME/YOUR_REPO/releases/latest"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=lanflix.db"
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "Lanflix",
    "Audience": "LanflixClient",
    "ExpirationMinutes": 43200
  },
  "LegacyJwt": {
    "Key": "",
    "Issuer": "LanflixLegacy",
    "Audience": "LanflixLegacyClient"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lanflix-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}",
          "shared": true
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/lanflix-errors-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "restrictedToMinimumLevel": "Error",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}",
          "shared": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Lanflix.Server"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5037"
}