# Lanflix Server - Docker Environment Configuration
# Copy this file to .env and update the values

# Media Paths (host machine paths to mount into container)
MEDIA_PATH_MOVIES=/path/to/your/movies
MEDIA_PATH_SERIES=/path/to/your/series

# TMDB API Configuration
TMDB_API_KEY=your_tmdb_api_key_here

# JWT Configuration
JWT_KEY=your_secret_jwt_key_here_minimum_32_characters
JWT_ISSUER=Lanflix
JWT_AUDIENCE=LanflixClients
JWT_EXPIRATION_MINUTES=60

# Redis Configuration (default values work with docker-compose)
REDIS_CONNECTION_STRING=redis:6379
REDIS_INSTANCE_NAME=lanflix:

# Transcoding Configuration
ENABLE_HARDWARE_ACCELERATION=true
PREFERRED_HW_ACCEL=auto
MAX_CONCURRENT_TRANSCODES=2
DEFAULT_BITRATE=8000000

# Streaming Configuration
ENABLE_DIRECT_PLAY=true
ENABLE_DIRECT_STREAM=true
CHUNK_SIZE=81920

# Database Configuration (default uses SQLite in container)
# For PostgreSQL, uncomment and configure:
# DATABASE_TYPE=PostgreSQL
# DATABASE_CONNECTION_STRING=Host=postgres;Database=lanflix;Username=lanflix;Password=your_password

# Logging Configuration
LOG_LEVEL=Information
LOG_FILE_PATH=/app/logs/lanflix-.log

# App Update Configuration
APK_STORAGE_PATH=/app/data/apk-updates
ENABLE_AUTO_UPDATE=true

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_PERMITS=100
RATE_LIMIT_WINDOW_MINUTES=1
