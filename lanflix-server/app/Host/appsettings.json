{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=lanflix.db;Pooling=True"
  },
  "Jwt": {
    "Issuer": "Lanflix",
    "Audience": "LanflixClient"
  },
  "Lanflix": {
    "ExternalApis": {
      "Tmdb": {
        "ApiKey": ""
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/lanflix-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } }
    ]
  }
}
