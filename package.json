{
  "name": "lanflix",
  "version": "2.5.2",
  "description": "Self-hosted streaming media server",
  "scripts": {
    "build:server": "node build-tools/scripts/build-server.js",
    "build:android": "build-tools\\android\\build-apk.bat",
    "build:installer": "build-tools\\server\\build-installer.bat",
    "build:all": "npm run build:server && npm run build:android",
    "dev:backend": "cd server/backend && npm run dev",
    "dev:frontend": "cd server/frontend && npm run dev",
    "release": "build-tools\\scripts\\release.bat",
    "version:bump": "node build-tools/scripts/bump-version.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JarlTheGamer/Applications."
  },
  "keywords": [
    "streaming",
    "media-server",
    "android",
    "self-hosted"
  ],
  "author": "",
  "license": "MIT"
}
