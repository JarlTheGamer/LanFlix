<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070709"
    tools:context=".MainActivity">

    <!-- Fragment Container (Full Screen Scrollable Area) -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Floating Sticky Glass Header Bar (90dp height, bottom-aligned icons, zero clipping) -->
    <RelativeLayout
        android:id="@+id/top_header_bar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@android:color/transparent"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp"
        android:elevation="30dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txt_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="lanflix"
            android:textColor="#E50914"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_top_search"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_top_search"
                app:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_top_cast"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:padding="6dp"
                android:src="@drawable/ic_top_cast"
                app:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btn_top_bookmark"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:padding="6dp"
                android:src="@drawable/ic_top_bookmark"
                app:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/top_profile_avatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:background="#E50914"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Material Bottom Navigation Bar (Compact 52dp, Textless, Non-Transparent) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#070709"
        android:elevation="30dp"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="unlabeled"
        app:itemActiveIndicatorStyle="@null"
        app:itemRippleColor="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/menu_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>